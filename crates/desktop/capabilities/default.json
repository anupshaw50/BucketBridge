{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and the extra main windows (main-1, main-2, ...): receive backend events, native file dialogs and message boxes, open the project page in the browser, reveal local files, and write (never read) the clipboard.",
  "windows": ["main", "main-*"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/anupshaw50/BucketBridge" },
        { "url": "https://github.com/anupshaw50/BucketBridge/*" }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-secret"
  ]
}
